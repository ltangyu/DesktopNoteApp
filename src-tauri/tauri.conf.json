{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopNoteApp",
  "version": "0.2.0",
  "identifier": "com.example.desktopnoteapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "極簡記事本",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "copyright": "Copyright © 2026",
    "category": "Productivity",
    "shortDescription": "極簡多分頁記事本",
    "longDescription": "極簡風格的多分頁記事本，主分類 + 子分類兩層結構，自動保存。"
  }
}
